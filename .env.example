# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.
APP_ENV=local                       # local | test | production (en production APPROVAL_TOKEN es obligatorio)
REDIS_URL=redis://localhost:6379/0  # con Docker Compose se usa redis://redis:6379/0

# --- Proveedor de LLM ---------------------------------------------------------------------------------
# openai = proveedor real | local = modo determinista SIN llamadas a un LLM (no consume tokens)
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=                       # nombre del modelo de OpenAI a usar (obligatorio con LLM_PROVIDER=openai)
# Tarifas en USD por millón de tokens, para ESTIMAR costos. Si se dejan vacías, el costo figura como «desconocido».
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# --- Observabilidad (LangSmith, opcional) -------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=l10n-qa-orchestrator

# --- Aprobación humana --------------------------------------------------------------------------------
APPROVAL_TOKEN=                     # se envía en el encabezado X-Approval-Token de POST /tasks/{job_id}/approve

# --- Ajustes opcionales -------------------------------------------------------------------------------
WORKER_CONCURRENCY=3                # tareas simultáneas por worker
MAX_ATTEMPTS=3                      # intentos ante interrupciones o fallas transitorias
LEASE_SECONDS=120                   # una tarea RUNNING sin latidos durante este tiempo se considera interrumpida
EMBEDDED_WORKER=false               # true = la API procesa la cola en el mismo proceso (útil sin Docker)
INPUT_ROOT=./fixtures               # única carpeta desde la que la API acepta archivos
OUTPUT_DIR=./salida                 # informes y manifiestos de la importación simulada
